const mineflayer = require('mineflayer');

function createBot() {
  const bot = mineflayer.createBot({
    host: 'BR-CRAFT.aternos.me',
    port: 31232,
    username: 'AfkJumpBot',
    version: '1.20.1' // إصدار مستقر ومتوافق مع ViaVersion
  });

  // ضع كلمة المرور الخاصة بالبوت هنا بين علامتي التنصيص
  const PASSWORD = 'Booot123'; 

  bot.on('spawn', () => {
    console.log('Bot joined the server successfully!');

    // إرسال أمر التسجيل للحسابات الجديدة
    setTimeout(() => {
      bot.chat(`/register ${PASSWORD} ${PASSWORD}`);
    }, 2000);

    // إرسال أمر تسجيل الدخول للحسابات المسجلة مسبقاً
    setTimeout(() => {
      bot.chat(`/login ${PASSWORD}`);
    }, 4000);
  });

  // نظام منع الـ AFK (يقفز كل 5 ثوانٍ)
  setInterval(() => {
    if (bot.entity) {
      bot.setControlState('jump', true);
      setTimeout(() => {
        bot.setControlState('jump', false);
      }, 500); // مدة القفزة نصف ثانية
    }
  }, 5000); // 5000 ميللي ثانية = 5 ثوانٍ

  bot.on('kick', (reason) => {
    console.log(`Bot was kicked because: ${reason}`);
  });

  bot.on('error', (err) => {
    console.log('Connection error code:', err.code);
  });

  // إعادة الاتصال تلقائياً إذا انقطع الاتصال أو أغلقت السيرفرات
  bot.on('end', () => {
    console.log('Connection lost, reconnecting in 5 seconds...');
    setTimeout(createBot, 5000);
  });
}

createBot();

